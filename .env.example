DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Optional USD prices per 1M tokens. Set all three to override built-in
# DeepSeek peak/off-peak pricing.
# LLM_CACHE_HIT_COST_PER_1M_TOKENS=0.014
# LLM_CACHE_MISS_COST_PER_1M_TOKENS=0.44
# LLM_OUTPUT_COST_PER_1M_TOKENS=1.32
