DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Optional PEAK USD prices per 1M tokens for the selected supported model.
# Overrides (complete or partial) still use half price off-peak, including
# weekends and Chinese public holidays. Unknown models/calendars stay unavailable.
# These are Flash peak rates; Pro has separate built-in rates. Leave unset
# to use model-specific defaults rather than applying Flash rates to Pro.
# These USD overrides do not change the independent official CNY prices
# used by the Chinese UI; CNY is never calculated using an exchange rate.
# LLM_CACHE_HIT_COST_PER_1M_TOKENS=0.006
# LLM_CACHE_MISS_COST_PER_1M_TOKENS=0.30
# LLM_OUTPUT_COST_PER_1M_TOKENS=1.20
