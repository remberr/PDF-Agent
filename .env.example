DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
LOG_LEVEL=INFO
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=3600

# PostgreSQL + pgvector API storage. Explicit Alembic upgrade is required.
# Keep retention disabled during historical import and verification.
SESSION_RETENTION_ENABLED=false
# No password defaults. Store real values only in ignored local files/environment.
# POSTGRES_PASSWORD=
# POSTGRES_PORT=55433
# Percent-encode password characters in URLs, e.g. @ -> %40, / -> %2F.
# DATABASE_URL=postgresql+psycopg://pdf_agent:<encoded-password>@127.0.0.1:55433/pdf_agent_local
# TEST_DATABASE_URL=postgresql+psycopg://pdf_agent:<encoded-password>@127.0.0.1:55433/pdf_agent_test
# Compose app profile uses the internal hostname, never localhost:
# DOCKER_DATABASE_URL=postgresql+psycopg://pdf_agent:<encoded-password>@db:5432/pdf_agent_local
# Tests NEVER fall back to DATABASE_URL; dedicated loopback *_test DB only.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
# PDF_AGENT_RUN_POSTGRES_TESTS=0

# Optional PEAK USD prices per 1M tokens for the selected supported model.
# Overrides (complete or partial) still use half price off-peak, including
# weekends and Chinese public holidays. Unknown models/calendars stay unavailable.
# These are Flash peak rates; Pro has separate built-in rates. Leave unset
# to use model-specific defaults rather than applying Flash rates to Pro.
# These USD overrides do not change the independent official CNY prices
# used by the Chinese UI; CNY is never calculated using an exchange rate.
# LLM_CACHE_HIT_COST_PER_1M_TOKENS=0.006
# LLM_CACHE_MISS_COST_PER_1M_TOKENS=0.30
# LLM_OUTPUT_COST_PER_1M_TOKENS=1.20
